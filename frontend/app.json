{
  "expo": {
    "name": "Auto Parts Store",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.partnumberfirst.eepol0",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan part barcodes and QR codes",
        "NSFaceIDUsageDescription": "Unlock your account securely",
        "NSPhotoLibraryUsageDescription": "Attach part photos from your gallery",
        "NSLocationWhenInUseUsageDescription": "Tag purchase location on stock"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.partnumberfirst.eepol0",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan part barcodes and QR codes"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach part photos from your gallery",
          "cameraPermission": "Take part photos with the camera"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your account securely"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

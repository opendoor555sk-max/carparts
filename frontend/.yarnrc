# Yarn v1 config
# EAS Android build workers run Node 20, but @zxing/library@0.23.0 declares
# engines.node ">= 24". @zxing is only used for the web barcode scanner and is
# not required by the native APK, so skip the strict engine check to let
# `yarn install --frozen-lockfile` succeed during the EAS build.
ignore-engines true
